page {
  background: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx 30rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background: #7c5cfc;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  text-align: center;
  width: 100%;
}

.btn-primary[disabled] {
  background: #ccc;
}

.btn-cancel {
  background: #fff;
  color: #f56c6c;
  border: 2rpx solid #f56c6c;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-beginner { background: #e1f3d8; color: #67c23a; }
.tag-intermediate { background: #fdf6ec; color: #e6a23c; }
.tag-advanced { background: #fde2e2; color: #f56c6c; }
.tag-scheduled { background: #e1f3d8; color: #67c23a; }
.tag-hold { background: #fdf6ec; color: #e6a23c; }
.tag-confirmed { background: #d9ecff; color: #409eff; }
.tag-cancelled { background: #f0f0f0; color: #999; }
.tag-checked_in { background: #e1f3d8; color: #67c23a; }

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-danger {
  color: #f56c6c;
}

.text-success {
  color: #67c23a;
}
