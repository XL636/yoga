.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: bold;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.detail-label {
  color: #999;
}

.detail-desc {
  margin-top: 20rpx;
}

.detail-desc .text-muted {
  display: block;
  margin-top: 8rpx;
  line-height: 1.6;
}

.booking-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.btn-group {
  margin-top: 10rpx;
}

.btn-cancel {
  width: 100%;
  text-align: center;
}
