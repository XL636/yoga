.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab-active {
  color: #7c5cfc;
  font-weight: bold;
  border-bottom: 4rpx solid #7c5cfc;
}

.booking-card {
  padding: 28rpx;
}

.booking-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.booking-name {
  font-size: 30rpx;
  font-weight: bold;
}

.booking-info {
  font-size: 26rpx;
  color: #666;
}

.booking-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-small {
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  display: inline-block;
}

.btn-confirm {
  background: #7c5cfc;
  color: #fff;
  border: none;
}

.btn-cancel-small {
  background: #fff;
  color: #f56c6c;
  border: 2rpx solid #f56c6c;
}
