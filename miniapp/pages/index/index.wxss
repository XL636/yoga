.date-bar {
  white-space: nowrap;
  padding: 20rpx 0;
  margin-bottom: 10rpx;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  min-width: 100rpx;
}

.date-active {
  background: #7c5cfc;
  color: #fff;
}

.date-label {
  font-size: 28rpx;
  font-weight: bold;
}

.date-weekday {
  font-size: 22rpx;
  margin-top: 4rpx;
  opacity: 0.7;
}

.session-card {
  padding: 28rpx;
}

.session-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.session-name {
  font-size: 32rpx;
  font-weight: bold;
}

.session-info {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.session-time {
  color: #333;
  font-weight: 500;
}

.session-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.session-spots {
  font-size: 26rpx;
  font-weight: 500;
}
